<Page x:Class="ShoesAtt2.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesAtt2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <!--<RowDefinition Height="*> </RowDefinition>-->
            <!--<RowDefinition Height="*></RowDefinition>-->
        </Grid.RowDefinitions>

        <ListView Name="Listv" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Name="Border" BorderBrush="Black" BorderThickness="2">
                    <Grid Background="{Binding Color}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>

                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0" Grid.RowSpan="8">
                            <Image.Source>
                                <Binding Path="ProductsPhotoTrue">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /img/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding ProductsTitle}" Grid.Row="0" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsDescription}" Grid.Row="1" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsProducer, StringFormat=Производитель:{0}}" Grid.Row="2" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsSupplier, StringFormat=Поставщик:{0}}" Grid.Row="3" Grid.Column="1"></TextBlock>

                         <TextBlock Text="{Binding ProductsCost, StringFormat={}{0}р.}" Grid.Row="4" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsMeasure, StringFormat=Единицы измерения:{0}}" Grid.Row="5" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsCountOnInventory, StringFormat=Количество на складе:{0}}" Grid.Row="6" Grid.Column="1"></TextBlock>

                        <TextBlock Text="{Binding ProductsDiscount, StringFormat=Скидка: {0}%}" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"></TextBlock>
                    </Grid>
                     </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
