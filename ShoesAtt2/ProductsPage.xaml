<Page x:Class="ShoesAtt2.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesAtt2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"> </RowDefinition>
            <!--<RowDefinition Height="*></RowDefinition>-->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <TextBlock>
                    Поиск ( для поиска по нескольким критериям вводите данные через запятую )
                </TextBlock>
                <TextBox Name="SearchTB" Width="500px" Margin="20px" TextChanged="SearchTB_TextChanged" Height="30px" FontFamily="Times New Roman" FontSize="25px">
                    
                </TextBox>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                
                <RadioButton GroupName="sorting" Name="sortDesc" FontSize="14px" Checked="sortDesc_Checked">
                    По убыванию товара на складе
                </RadioButton>
                <RadioButton Name="sortAsc" GroupName="sorting" FontSize="14px" Checked="sortAsc_Checked">
                    По возрастанию товара на складе
                </RadioButton>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <ComboBox Name="FilterCB" SelectionChanged="FilterCB_SelectionChanged" Width="300px" Height="28px">
                    <TextBlock Margin="0px">
                        Все поставщики
                    </TextBlock>

                    <TextBlock Margin="0px">
                        Kari
                    </TextBlock>

                    <TextBlock Margin="0px">
                        Обувь для вас
                    </TextBlock>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <ListView Name="Listv" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Name="Border" BorderBrush="Black" BorderThickness="2">
                    <Grid Background="{Binding Color}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="1000px"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>

                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0" Grid.RowSpan="8">
                            <Image.Source>
                                <Binding Path="ProductsPhotoTrue">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /img/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding ProductsTitle}" Grid.Row="0" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsDescription}" Grid.Row="1" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsProducer, StringFormat=Производитель:{0}}" Grid.Row="2" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsSupplier, StringFormat=Поставщик:{0}}" Grid.Row="3" Grid.Column="1"></TextBlock>

                            <StackPanel  Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="realCost" TextDecorations="{Binding TextStyle}" Foreground="{Binding CostColor}" Text="{Binding ProductsCost, StringFormat={}{0}р.}"></TextBlock>
                                <TextBlock x:Name="discCost" Foreground="{Binding DiscCostColor}" Text="{Binding ChangedCost, StringFormat={}{0}р.}"></TextBlock>
                            </StackPanel>
                        
                        <TextBlock Text="{Binding ProductsMeasure, StringFormat=Единицы измерения:{0}}" Grid.Row="5" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding ProductsCountOnInventory, StringFormat=Количество на складе:{0}}" Grid.Row="6" Grid.Column="1"></TextBlock>

                        <TextBlock Text="{Binding ProductsDiscount, StringFormat=Скидка: {0}%}" Grid.RowSpan="7" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"></TextBlock>
                    </Grid>
                     </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
